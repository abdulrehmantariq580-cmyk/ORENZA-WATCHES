<section class="hero-slider-section">
  <div class="slider-container">
    <!-- Slider Navigation Arrows -->
    <button class="slider-arrow prev-arrow" type="button" aria-label="Previous Slide">
      <i class="fas fa-chevron-left"></i>
    </button>
    <button class="slider-arrow next-arrow" type="button" aria-label="Next Slide">
      <i class="fas fa-chevron-right"></i>
    </button>

    <!-- Slides Wrapper: PURE CLEAN 16:9 IMAGES WITHOUT ANY OVERLAYS OR DULLNESS -->
    <div class="slides-wrapper" id="heroSlideWrapper">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="hero-slide" {{ block.shopify_attributes }}>
            {%- if block.settings.button_link != blank -%}<a href="{{ block.settings.button_link }}" style="display:block; width:100%; height:100%;">{%- endif -%}
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 2400 }}" alt="{{ block.settings.heading | default: 'ORENZA Luxury Watches Banner' }}" class="hero-banner-clean-img" loading="eager">
            {%- else -%}
              <img src="{{ 'hero-banner-1.jpg' | asset_url }}" alt="ORENZA Banner" class="hero-banner-clean-img" loading="eager">
            {%- endif -%}
            {%- if block.settings.button_link != blank -%}</a>{%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback Default Clean 16:9 Slides -->
        <div class="hero-slide">
          <img src="{{ 'hero-banner-1.jpg' | asset_url }}" alt="ORENZA Royal Collection" class="hero-banner-clean-img" loading="eager">
        </div>
        <div class="hero-slide">
          <img src="{{ 'hero-banner-2.jpg' | asset_url }}" alt="ORENZA Limited Edition" class="hero-banner-clean-img">
        </div>
        <div class="hero-slide">
          <img src="{{ 'hero-banner-3.jpg' | asset_url }}" alt="ORENZA Masterpieces" class="hero-banner-clean-img">
        </div>
      {%- endif -%}
    </div>

    <!-- Dots (Dynamic according to actual blocks or 3 default) -->
    <div class="dots-container">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="slider-dot {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}"></div>
        {%- endfor -%}
      {%- else -%}
        <div class="slider-dot active" data-index="0"></div>
        <div class="slider-dot" data-index="1"></div>
        <div class="slider-dot" data-index="2"></div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Slider",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide Banner (16:9)",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "16:9 Banner Image (Theme Editor)"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Slide Click Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
