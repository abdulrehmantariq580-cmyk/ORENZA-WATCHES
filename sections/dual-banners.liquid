<section class="dual-banners-section">
  <!-- Banner 1 -->
  <a href="{{ section.settings.banner_1_link | default: routes.all_products_collection_url }}" class="promo-banner">
    {%- if section.settings.banner_1_image != blank -%}
      <img src="{{ section.settings.banner_1_image | image_url: width: 1000 }}" alt="{{ section.settings.banner_1_alt | default: 'Men Collection Banner' }}" loading="lazy">
    {%- else -%}
      <div style="width: 100%; height: 350px; background: linear-gradient(135deg, #1f1a14 0%, #0d0c0a 100%); display:flex; flex-direction:column; align-items:center; justify-content:center; color:#D4AF37; border: 1px solid #333;">
        <i class="fas fa-crown" style="font-size: 48px; margin-bottom: 15px;"></i>
        <h3 style="font-family:'Playfair Display',serif; font-size: 24px; color:#fff; letter-spacing:2px;">ROYAL MEN'S EDITION</h3>
        <p style="font-size:12px; color:#aaa; margin-top: 5px; text-transform:uppercase; letter-spacing:1.5px;">Explore Master Collection &rarr;</p>
      </div>
    {%- endif -%}
  </a>

  <!-- Banner 2 -->
  <a href="{{ section.settings.banner_2_link | default: routes.all_products_collection_url }}" class="promo-banner">
    {%- if section.settings.banner_2_image != blank -%}
      <img src="{{ section.settings.banner_2_image | image_url: width: 1000 }}" alt="{{ section.settings.banner_2_alt | default: 'Limited Editions Banner' }}" loading="lazy">
    {%- else -%}
      <div style="width: 100%; height: 350px; background: linear-gradient(135deg, #101924 0%, #070b10 100%); display:flex; flex-direction:column; align-items:center; justify-content:center; color:#D4AF37; border: 1px solid #333;">
        <i class="fas fa-gem" style="font-size: 48px; margin-bottom: 15px;"></i>
        <h3 style="font-family:'Playfair Display',serif; font-size: 24px; color:#fff; letter-spacing:2px;">LIMITED TIMEPIECES</h3>
        <p style="font-size:12px; color:#aaa; margin-top: 5px; text-transform:uppercase; letter-spacing:1.5px;">Discover Exclusives &rarr;</p>
      </div>
    {%- endif -%}
  </a>
</section>

{% schema %}
{
  "name": "Dual Promo Banners",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_1_image",
      "label": "First Banner Image"
    },
    {
      "type": "text",
      "id": "banner_1_alt",
      "label": "First Banner Alt Text",
      "default": "Men's Collection Banner"
    },
    {
      "type": "url",
      "id": "banner_1_link",
      "label": "First Banner Link"
    },
    {
      "type": "image_picker",
      "id": "banner_2_image",
      "label": "Second Banner Image"
    },
    {
      "type": "text",
      "id": "banner_2_alt",
      "label": "Second Banner Alt Text",
      "default": "Premium Editions Banner"
    },
    {
      "type": "url",
      "id": "banner_2_link",
      "label": "Second Banner Link"
    }
  ],
  "presets": [
    {
      "name": "Dual Promo Banners"
    }
  ]
}
{% endschema %}
