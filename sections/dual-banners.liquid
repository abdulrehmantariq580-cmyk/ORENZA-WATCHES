<section class="dual-banners-section">
  <!-- Banner 1 -->
  <a href="{{ section.settings.banner_1_link | default: routes.all_products_collection_url }}" class="promo-banner">
    {%- if section.settings.banner_1_image != blank -%}
      <img src="{{ section.settings.banner_1_image | image_url: width: 1000 }}" alt="{{ section.settings.banner_1_alt | default: 'Men Collection Banner' }}" loading="lazy">
    {%- else -%}
      <img src="{{ 'dual-banner-1.png' | asset_url }}" alt="Royal Executive Men Collection" style="width: 100%; height: 350px; object-fit: cover;" loading="lazy">
    {%- endif -%}
  </a>

  <!-- Banner 2 -->
  <a href="{{ section.settings.banner_2_link | default: routes.all_products_collection_url }}" class="promo-banner">
    {%- if section.settings.banner_2_image != blank -%}
      <img src="{{ section.settings.banner_2_image | image_url: width: 1000 }}" alt="{{ section.settings.banner_2_alt | default: 'Limited Editions Banner' }}" loading="lazy">
    {%- else -%}
      <img src="{{ 'dual-banner-2.png' | asset_url }}" alt="Executive Luxury Watch Collection" style="width: 100%; height: 350px; object-fit: cover;" loading="lazy">
    {%- endif -%}
  </a>
</section>

{% schema %}
{
  "name": "Dual Promo Banners",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_1_image",
      "label": "First Banner Image"
    },
    {
      "type": "text",
      "id": "banner_1_alt",
      "label": "First Banner Alt Text",
      "default": "Men's Collection Banner"
    },
    {
      "type": "url",
      "id": "banner_1_link",
      "label": "First Banner Link"
    },
    {
      "type": "image_picker",
      "id": "banner_2_image",
      "label": "Second Banner Image"
    },
    {
      "type": "text",
      "id": "banner_2_alt",
      "label": "Second Banner Alt Text",
      "default": "Premium Editions Banner"
    },
    {
      "type": "url",
      "id": "banner_2_link",
      "label": "Second Banner Link"
    }
  ],
  "presets": [
    {
      "name": "Dual Promo Banners"
    }
  ]
}
{% endschema %}
