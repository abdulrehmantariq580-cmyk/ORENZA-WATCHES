<section class="dual-banners-section">
  <!-- Banner 1 (Clean Image Only from Theme Editor) -->
  <div class="promo-banner-wrapper">
    {%- if section.settings.banner_1_link != blank -%}<a href="{{ section.settings.banner_1_link }}" class="promo-banner">{%- else -%}<div class="promo-banner">{%- endif -%}
      {%- if section.settings.banner_1_image != blank -%}
        <img src="{{ section.settings.banner_1_image | image_url: width: 1200 }}" alt="{{ section.settings.banner_1_alt | default: 'Banner' }}" class="dual-clean-img" loading="lazy">
      {%- else -%}
        <img src="{{ 'dual-banner-1.png' | asset_url }}" alt="Royal Executive Men Collection" class="dual-clean-img" loading="lazy">
      {%- endif -%}
    {%- if section.settings.banner_1_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
  </div>

  <!-- Banner 2 (Clean Image Only from Theme Editor) -->
  <div class="promo-banner-wrapper">
    {%- if section.settings.banner_2_link != blank -%}<a href="{{ section.settings.banner_2_link }}" class="promo-banner">{%- else -%}<div class="promo-banner">{%- endif -%}
      {%- if section.settings.banner_2_image != blank -%}
        <img src="{{ section.settings.banner_2_image | image_url: width: 1200 }}" alt="{{ section.settings.banner_2_alt | default: 'Banner' }}" class="dual-clean-img" loading="lazy">
      {%- else -%}
        <img src="{{ 'dual-banner-2.png' | asset_url }}" alt="Executive Luxury Watch Collection" class="dual-clean-img" loading="lazy">
      {%- endif -%}
    {%- if section.settings.banner_2_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Dual Clean Banners",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_1_image",
      "label": "First Banner Image (Theme Editor)"
    },
    {
      "type": "url",
      "id": "banner_1_link",
      "label": "First Banner Link (Optional)"
    },
    {
      "type": "image_picker",
      "id": "banner_2_image",
      "label": "Second Banner Image (Theme Editor)"
    },
    {
      "type": "url",
      "id": "banner_2_link",
      "label": "Second Banner Link (Optional)"
    }
  ],
  "presets": [
    {
      "name": "Dual Clean Banners"
    }
  ]
}
{% endschema %}
