<section class="watch-brands-section">
  <div class="section-header">
    {%- if section.settings.subtitle != blank -%}
      <div class="section-subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    <h2 class="section-title">{{ section.settings.title | default: 'TOP CATEGORIES' }}</h2>
  </div>

  <div class="brands-scroll-wrapper">
    <div class="brands-container">
      {%- for i in (1..2) -%}
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.link | default: routes.collections_url }}" class="brand-circle-item" {{ block.shopify_attributes }}>
              <div class="brand-circle">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 300, height: 300 }}" alt="{{ block.settings.brand_name }}" class="cat-clean-img" loading="lazy">
                {%- else -%}
                  <img src="{{ 'cat-1.png' | asset_url }}" alt="Category" class="cat-clean-img" loading="lazy">
                {%- endif -%}
              </div>
              <span class="brand-name">{{ block.settings.brand_name }}</span>
            </a>
          {%- endfor -%}
        {%- else -%}
          <!-- Default Clean Category Images (No Icons, No Dullness) -->
          <a href="{{ routes.collections_url }}" class="brand-circle-item">
            <div class="brand-circle"><img src="{{ 'cat-1.png' | asset_url }}" alt="Minimal Classic" class="cat-clean-img"></div>
            <span class="brand-name">Minimal Classic</span>
          </a>
          <a href="{{ routes.collections_url }}" class="brand-circle-item">
            <div class="brand-circle"><img src="{{ 'cat-2.png' | asset_url }}" alt="Royal Chronograph" class="cat-clean-img"></div>
            <span class="brand-name">Royal Chrono</span>
          </a>
          <a href="{{ routes.collections_url }}" class="brand-circle-item">
            <div class="brand-circle"><img src="{{ 'cat-3.png' | asset_url }}" alt="Diver Automatic" class="cat-clean-img"></div>
            <span class="brand-name">Diver Automatic</span>
          </a>
          <a href="{{ routes.collections_url }}" class="brand-circle-item">
            <div class="brand-circle"><img src="{{ 'cat-4.png' | asset_url }}" alt="Titanium Edition" class="cat-clean-img"></div>
            <span class="brand-name">Titanium Series</span>
          </a>
          <a href="{{ routes.collections_url }}" class="brand-circle-item">
            <div class="brand-circle"><img src="{{ 'cat-5.png' | asset_url }}" alt="Vintage Cushion" class="cat-clean-img"></div>
            <span class="brand-name">Vintage Cushion</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Top Categories Circles",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "EXPLORE OUR COLLECTION"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "TOP CATEGORIES"
    }
  ],
  "blocks": [
    {
      "type": "category_item",
      "name": "Category Circle",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Watch Image (Clean)"
        },
        {
          "type": "text",
          "id": "brand_name",
          "label": "Category Name",
          "default": "Royal Chrono"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link Target"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Top Categories Circles",
      "settings": {
        "title": "TOP CATEGORIES",
        "subtitle": "EXPLORE OUR COLLECTION"
      },
      "blocks": [
        { "type": "category_item", "settings": { "brand_name": "Minimal Classic" } },
        { "type": "category_item", "settings": { "brand_name": "Royal Chrono" } },
        { "type": "category_item", "settings": { "brand_name": "Diver Automatic" } },
        { "type": "category_item", "settings": { "brand_name": "Titanium Series" } },
        { "type": "category_item", "settings": { "brand_name": "Vintage Cushion" } }
      ]
    }
  ]
}
{% endschema %}
