<header class="site-header">
  <div class="navbar">
    <!-- Hamburger Toggle for Mobile -->
    <button class="menu-toggle" type="button" aria-label="Open Navigation Menu">
      <i class="fas fa-bars"></i>
    </button>

    <!-- Header Logo: Pure Single Image Logo (Icon Left + Text Right) -->
    <div class="logo-container">
      <a href="{{ routes.root_url }}" class="header-logo-link">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 600 }}" alt="{{ shop.name }}" class="header-logo-img">
        {%- else -%}
          <img src="{{ 'orenza-header-logo.png' | asset_url }}" alt="ORENZA - CRAFTED FOR ELEGANCE" class="header-logo-img">
        {%- endif -%}
      </a>
    </div>

    <!-- Desktop Navigation Links -->
    <ul class="nav-links">
      {%- if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 -%}
        {%- for link in linklists[section.settings.menu].links -%}
          <li class="{% if link.active %}active{% endif %}">
            <a href="{{ link.url }}">{{ link.title }}</a>
          </li>
        {%- endfor -%}
      {%- else -%}
        <li class="active"><a href="{{ routes.root_url }}">HOME</a></li>
        <li><a href="{{ routes.collections_url }}">COLLECTIONS</a></li>
        <li><a href="#about-us">ABOUT US</a></li>
        <li><a href="#contact-us">CONTACT US</a></li>
      {%- endif -%}
    </ul>

    <!-- Header Right Action Icons (Heart removed, Search & Cart kept clean) -->
    <div class="nav-icons">
      <a href="{{ routes.search_url }}" class="icon-box" aria-label="Search">
        <i class="fas fa-search"></i>
      </a>
      <a href="{{ routes.cart_url }}" class="icon-box cart-icon" aria-label="Cart">
        <i class="fas fa-shopping-bag"></i>
        <span class="badge" id="CartCount">{{ cart.item_count | default: 0 }}</span>
      </a>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="mobile-nav-drawer" id="mobileNavDrawer" aria-hidden="true">
  <div class="drawer-header">
    <div class="drawer-logo">
      <img src="{{ 'orenza-header-logo.png' | asset_url }}" alt="ORENZA" style="height: 38px; width: auto; object-fit: contain;">
    </div>
    <button class="drawer-close" id="drawerCloseBtn" aria-label="Close Navigation Menu">
      <i class="fas fa-times"></i>
    </button>
  </div>

  <ul class="mobile-nav-list">
    {%- if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 -%}
      {%- for link in linklists[section.settings.menu].links -%}
        <li>
          <a href="{{ link.url }}">{{ link.title }} <i class="fas fa-chevron-right" style="font-size: 11px;"></i></a>
        </li>
      {%- endfor -%}
    {%- else -%}
      <li><a href="{{ routes.root_url }}">HOME <i class="fas fa-chevron-right" style="font-size: 11px;"></i></a></li>
      <li><a href="{{ routes.collections_url }}">COLLECTIONS <i class="fas fa-chevron-right" style="font-size: 11px;"></i></a></li>
      <li><a href="#about-us">ABOUT US <i class="fas fa-chevron-right" style="font-size: 11px;"></i></a></li>
      <li><a href="#contact-us">CONTACT US <i class="fas fa-chevron-right" style="font-size: 11px;"></i></a></li>
    {%- endif -%}
  </ul>

  <div class="drawer-footer">
    <div class="drawer-contact-item">
      <i class="fas fa-phone-alt"></i>
      <span>{{ section.settings.phone_number | default: '+92 320 9343453' }}</span>
    </div>
    <div class="drawer-contact-item">
      <i class="fas fa-envelope"></i>
      <span>{{ section.settings.email_address | default: 'support@orenza.com' }}</span>
    </div>
  </div>
</div>

<div class="drawer-backdrop" id="drawerBackdrop"></div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Header Logo (Upload if desired)"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Name",
      "default": "ORENZA"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Brand Tagline",
      "default": "CRAFTED FOR ELEGANCE"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Drawer Phone Number",
      "default": "+92 320 9343453"
    },
    {
      "type": "text",
      "id": "email_address",
      "label": "Drawer Email",
      "default": "support@orenza.com"
    }
  ]
}
{% endschema %}
