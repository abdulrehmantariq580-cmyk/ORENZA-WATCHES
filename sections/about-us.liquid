<section class="about-us-section" id="about-us">
  <div class="about-container">
    <div class="about-text-content">
      <div class="about-subtitle">{{ section.settings.subtitle | default: 'THE ORENZA HERITAGE' }}</div>
      <h2 class="about-title">{{ section.settings.heading | default: 'Crafting Timeless <span>Elegance</span> & Precision' }}</h2>
      <div class="about-description">
        {{ section.settings.paragraph_1 | default: 'Welcome to ORENZA, where luxury meets unmatched craftsmanship. We are dedicated to bringing you the finest timepieces that define status, style, and sophistication. Every watch in our collection is curated to ensure absolute perfection on your wrist.' }}
      </div>
      <div class="about-description">
        {{ section.settings.paragraph_2 | default: 'Whether you are a seasoned horology collector or searching for your signature everyday luxury piece, our commitment to uncompromising quality remains at the core of everything we do.' }}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="about-btn">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="about-image-content">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.heading | escape }}" class="about-clean-img" loading="lazy">
      {%- else -%}
        <img src="{{ 'about-heritage.png' | asset_url }}" alt="ORENZA Heritage Executive" class="about-clean-img" loading="lazy">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Us",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE ORENZA HERITAGE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (use <span> for gold)",
      "default": "Crafting Timeless <span>Elegance</span> & Precision"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "First Paragraph",
      "default": "Welcome to ORENZA, where luxury meets unmatched craftsmanship. We are dedicated to bringing you the finest timepieces that define status, style, and sophistication. Every watch in our collection is curated to ensure absolute perfection on your wrist."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Second Paragraph",
      "default": "Whether you are a seasoned horology collector or searching for your signature everyday luxury piece, our commitment to uncompromising quality remains at the core of everything we do."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Discover Our Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Heritage Watch Image"
    }
  ],
  "presets": [
    {
      "name": "About Us"
    }
  ]
}
{% endschema %}
